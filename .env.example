# Copy to .env.local for local development, and add the same names in Vercel
# (Project → Settings → Environment Variables).

# From Supabase: Project Settings → API. These two are safe to expose to browsers;
# the database's row-level security rules are what protect the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Demo mode: shows the "switch demo user" menu for @demo.test accounts.
# Set to false (or remove) on the live system.
DEMO_MODE=true
# Shared password for the fake @demo.test logins. Never commit the real value.
DEMO_PASSWORD=
