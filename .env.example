# Copy to .env.local for local development, and add the same names in Vercel
# (Project → Settings → Environment Variables).

# From Supabase: Project Settings → API. These two are safe to expose to browsers;
# the database's row-level security rules are what protect the data.
# If left blank, the app uses the TEST project (see src/lib/supabase/config.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Demo mode: shows the "View as" menu for @demo.test accounts. It turns on
# automatically when DEMO_PASSWORD is set. Never set DEMO_PASSWORD on live.
DEMO_MODE=true
# Shared password for the fake @demo.test logins. Never commit the real value.
DEMO_PASSWORD=

# Supabase admin key, needed only to invite new people from Admin > People.
# Server only. Never commit it and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key for AI photo labeling (room, tags, caption, MLS checks).
# Server only. Without it, uploads work and AI simply doesn't run.
ANTHROPIC_API_KEY=

# Email (Resend) for reverse prospecting requests and help reports to our team.
# Without these, emails are logged in Admin > Settings instead of sent; the
# tasks are created either way. Server only.
RESEND_API_KEY=
EMAIL_FROM=

# Sentry error alerts. Create a Next.js project in Sentry and copy its DSN.
# Without it, error alerts are off. The DSN is safe to expose to browsers.
NEXT_PUBLIC_SENTRY_DSN=
# Optional: readable error locations (source maps). Server/build only.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
